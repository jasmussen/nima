{
  "colors": ["#000000", "#bbbbbb", "#cc0000"],
  "nodes": [
    { "text": "Bare en tanke" },
    { "text": "hverken rigtig eller forkert" },
    { "text": "den har ingen substans" },
    { "text": "for det er kun en tanke" },
    { "text": "Det er blot hverdag" },
    { "text": "tanker der flyver forbi" },
    { "text": "blev de tænkt af et menneske?" },
    { "text": "betyder det noget?" },
    { "text": "Parallelle historier" },
    { "text": "både korte og lange" },
    { "text": "historier der aldrig fik en slutning" },
    { "text": "nogen der ikke burde være fortalt" },
    { "text": "Og det er kun tanker" },
    { "text": "tid der går" },
    { "text": "altid fremad, aldrig bagud" },
    { "text": "historier vi digter" },
    { "text": "Historier der slutter" },
    { "text": "beskeder som ændrer alt" },
    { "text": "glimt og øjeblikke" },
    { "text": "sange der nu gør ondt" },
    { "text": "Blot tanker" },
    { "text": "en sum af alt" },
    { "text": "uden substans" },
    { "text": "en del af et hele" },
    { "text": "Snip snap snude" }
  ]
}
